# Chép file này thành .env rồi điền. .env đã nằm trong .gitignore — ĐỪNG commit.

# Gốc API FuelControl. Bắt buộc HTTPS.
FUELCONTROL_BASE_URL=https://fleet.seudambite.com

# API key cấp ở fleet.seudambite.com -> tab "API key".
# Chủ key phải có quyền reports.read. Scope CHỈ tick "read".
# Chuỗi key hiện đúng MỘT lần lúc cấp — chép ngay, mất thì cấp key mới.
FUELCONTROL_API_KEY=

# --- Tuỳ chọn, để trống là dùng mặc định ---

# Thời gian chờ mỗi request (ms).
FUELCONTROL_TIMEOUT_MS=15000

# Phanh gọi API: số request mỗi phút và mức bùng nổ tối đa.
# Có để một vòng lặp hỏng của agent không nện vào API đang phục vụ người thật.
FUELCONTROL_RATE_LIMIT_PER_MIN=30
FUELCONTROL_RATE_BURST=10

# Cho phép trỏ vào http://localhost khi chạy backend ở máy mình.
# TUYỆT ĐỐI không bật khi trỏ ra Internet.
FUELCONTROL_ALLOW_INSECURE_LOCAL=false
