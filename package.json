{
  "name": "fuelcontrol-mcp-data",
  "version": "0.1.0",
  "private": true,
  "description": "Máy chủ MCP chỉ-đọc cho FuelControl — hỏi số liệu giao nhận xe và xăng dầu bằng ngôn ngữ tự nhiên.",
  "type": "module",
  "bin": {
    "fuelcontrol-mcp": "dist/index.js",
    "fuelcontrol-mcp-http": "dist/serve.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "node dist/check.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "serve": "node dist/serve.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.6"
  }
}
